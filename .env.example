# ==============================================================================
# FantaSKI Backend - Przykładowa konfiguracja środowiska (.env.example)
# Skopiuj ten plik do .env (dla środowiska DEV) lub .env.test (dla TEST)
# ==============================================================================

# Środowisko (development / test / production)
ENVIRONMENT=development

# Konfiguracja połączenia z MongoDB
MONGO_URL=mongodb://localhost:27017/
MONGO_DB_NAME=FIS_DATA_DB_DEV

# Bezpieczeństwo i autoryzacja JWT (wygeneruj silny klucz min. 32 znaki!)
JWT_SECRET=twoj_bezpieczny_losowy_klucz_jwt_min_32_znaki
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth 2.0 (utwórz w Google Cloud Console)
GOOGLE_CLIENT_ID=twoj-google-client-id.apps.googleusercontent.com

# Adres e-mail początkowego administratora (nadawany automatycznie przy pierwszym logowaniu)
INITIAL_ADMIN_EMAIL=admin@example.com

# Opcjonalne: Zezwolenie na logowanie developerskie (TYLKO DLA DEV/TEST!)
ENABLE_DEV_LOGIN=true

# Zewnętrzne serwisy i integracje
GEMINI_API_KEY=twoj_klucz_gemini_api
CONFIG_EMAIL=twoj_email_esm
CONFIG_PASS=twoje_haslo_esm

# CORS - dozwolone domeny frontendu rozdzielone przecinkami (lub * dla otwartego API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://twoja-domena-frontend.onrender.com
